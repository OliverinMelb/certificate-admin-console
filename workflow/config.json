      {
        "name": "frontend-types",
        "dir": "frontend",
        "cmd": "node",
        "args": [
          "node_modules/vue-tsc/bin/vue-tsc.js",
          "--noEmit"
        ]
      },
      {
        "name": "frontend-build",
        "dir": "frontend",
        "cmd": "node",
        "args": [
          "node_modules/vite/bin/vite.js",
          "build"
        ]
      },
      {
        "name": "http-contracts",
        "dir": "backend",
        "cmd": "python",
        "args": [
          "-m",
          "pytest",
          "-q"
        ]
      },
      {
        "name": "startup-smoke",
        "dir": "",
        "cmd": "python",
        "args": [
          "-m",
          "pytest",
          "tests",
          "-q"
        ],
        "timeout_seconds": 600
      }
    ]
  },
  "workflow_classes": {
    "app-change": [
      "app"
    ]
  },
  "auto_check": null,
