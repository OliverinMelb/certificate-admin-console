    "rules": []
  },
  "project_conventions": {
    "schema_version": 1,
    "profile": "standard",
    "tracker": {
      "kind": "local",
      "remote": null,
      "doc": "docs/agents/issue-tracker.md",
      "publication_policy": "explicit"
    },
    "domain": {
